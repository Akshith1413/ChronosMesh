# ChronosMesh Environment Configuration Template
# Copy to .env and adjust variables as needed.

# ── Data Mode ────────────────────────────────────────────────────────────────
# DATA_SOURCE can be "demo" (in-memory scenario catalogue) or "live" (Kafka + Neo4j)
DATA_SOURCE=demo

# ── Kafka Configuration ──────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=events.raw
KAFKA_CAUSAL_TOPIC=events.causal
KAFKA_GROUP_ID=chronosmesh-consumer-group

# ── Flink Stream Processing ──────────────────────────────────────────────────
FLINK_OUT_OF_ORDERNESS_MS=500.0
FLINK_WINDOW_MS=1000.0

# ── Neo4j Database Configuration ─────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=chronosmesh2026
NEO4J_DATABASE=neo4j

# ── Mock Microservices & Fault Injection ─────────────────────────────────────
SIMULATE_NETWORK_DELAY=true
SIMULATE_CLOCK_SKEW=true
SIMULATE_OUT_OF_ORDER=true
SIMULATE_FAILURE=false

# ── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET_KEY=chronosmesh-secret-key-guru-2024-xQ9mP2vL
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
