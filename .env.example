# ChronosMesh environment template.  Copy to .env (git-ignored) and adjust.
# Nothing in this file is a real secret -- generate your own values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=local                     # local | production  (production refuses weak secrets, disables demo users)
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000

# ── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=                       # REQUIRED when ENVIRONMENT=production (>= 32 chars); or set JWT_SECRET_ARN
# JWT_SECRET_ARN=arn:aws:secretsmanager:ap-south-2:<account>:secret:chronosmesh/jwt
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENABLE_DEMO_USERS=true                # built-in guru/analyst/demo accounts; keep false in production
# USERS_JSON={"alice":{"password":"change-me","role":"admin"}}     # or USERS_SECRET_ARN
CORS_ORIGINS=                         # comma-separated explicit origins; '*' is rejected
METRICS_TOKEN=                        # when set, /metrics requires "Authorization: Bearer <token>"

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_EXPERIMENT_EVENTS=25000
MAX_EXECUTION_EVENTS=100000

# ── AWS (all optional: with none set, everything runs in memory) ─────────────
AWS_REGION=ap-south-2
# STORAGE_BACKEND=auto                # auto | memory | aws
# DYNAMODB_EXEC_TABLE=chronosmesh-prod-executions
# DYNAMODB_EVENTS_TABLE=chronosmesh-prod-events
# DYNAMODB_ANOMALY_TABLE=chronosmesh-prod-anomalies
# DYNAMODB_GRAPH_TABLE=chronosmesh-prod-causal-graphs
# S3_DATA_BUCKET=chronosmesh-prod-data-<account>
# SQS_EVENTS_QUEUE_URL=https://sqs.ap-south-2.amazonaws.com/<account>/chronosmesh-prod-events
# INGEST_MODE=queue                   # inline (default) | queue (API -> SQS -> worker)
# EXECUTION_TTL_DAYS=30
# CLOUDWATCH_METRICS=true             # worker publishes custom metrics to CloudWatch

# ── Observability ────────────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# GRAFANA_URL=http://localhost:3000
# CLOUDWATCH_DASHBOARD_URL=
# WORKER_METRICS_PORT=9100

# ── Optional streaming / graph stack (docker compose --profile full up) ──────
DATA_SOURCE=demo                      # demo (in-memory) | live (Kafka + Neo4j)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=events.raw
KAFKA_CAUSAL_TOPIC=events.causal
KAFKA_GROUP_ID=chronosmesh-consumer-group
FLINK_OUT_OF_ORDERNESS_MS=500.0
FLINK_WINDOW_MS=1000.0
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=                       # choose your own; compose reads it from the environment
NEO4J_DATABASE=neo4j

# ── Mock microservices & fault injection (legacy demo cluster) ───────────────
SIMULATE_NETWORK_DELAY=true
SIMULATE_CLOCK_SKEW=true
SIMULATE_OUT_OF_ORDER=true
SIMULATE_FAILURE=false
